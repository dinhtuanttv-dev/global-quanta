# Public browser settings for Supabase email/password authentication.
# Set these as Production environment variables in Vercel as well.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional backend API base URL; leave empty when using the Vite same-origin proxy locally.
VITE_API_BASE_URL=

# Market Data Gateway (SSI là nguồn chính, nguồn cũ là dự phòng — xem docs/MARKET_DATA_GATEWAY.md).
# false (mặc định): giữ nguyên đường gọi cũ. true: Watchlist, TopBar, OHLCV, universe, RS đi qua Gateway.
VITE_MARKET_GATEWAY_ENABLED=false
# Giao diện tầng nghiên cứu (AI học & thích ứng). false/để trống (mặc định): UI giữ nguyên, không gọi API nghiên cứu.
VITE_RESEARCH_UI=false
# Để trống khi Gateway cùng origin (Vite proxy /api -> backend :4000). Khi Gateway host riêng
# (Railway/Fly/VPS) thì đặt URL đó và thêm domain frontend vào FRONTEND_ORIGIN của backend.
VITE_MARKET_API_BASE_URL=
# Nguồn Bảng Siêu Quét AI: gateway (engine trên Gateway, dữ liệu SSI; tự dùng Project A nếu Gateway chưa có kết quả) | projectA (mặc định).
VITE_SCANNER_SOURCE=projectA
