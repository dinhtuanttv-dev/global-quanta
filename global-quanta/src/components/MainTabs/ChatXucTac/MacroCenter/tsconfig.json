{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "noEmit": true, "lib": ["ES2022", "DOM"], "types": ["node"], "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "scripts/**/*.tsx"]
}
