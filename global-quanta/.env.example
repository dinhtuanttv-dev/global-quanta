# API Keys for Smart Note AI (get free keys at https://console.groq.com and https://aistudio.google.com)
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GOOGLE_API_KEY=your_google_api_key_here

# API Base URL for backend server (quant-macro-scanner, Next.js)
# ------------------------------------------------------------------
# LOCAL DEV: leave EMPTY. The Vite dev server proxies relative /api
# requests to http://localhost:3000 (see vite.config.ts -> server.proxy).
# An empty value keeps all /api calls same-origin through the proxy, which
# is required because the backend API routes (except /api/tang1) do NOT
# send CORS headers -- using an absolute host would cause cross-origin
# failures (404/network errors).
#
# PRODUCTION: set VITE_API_BASE_URL=https://tuan-quant-scanner-psi.vercel.app
# via the Vercel dashboard (this file is git-ignored, see .gitignore).
# =============================================================================
VITE_API_BASE_URL=

# Supabase Auth (the publishable/anon key is safe for browser use; never put a secret/service-role key here)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Alternative: Direct AI API keys (if not using backend)
# VITE_GROQ_API_KEY=your_groq_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
