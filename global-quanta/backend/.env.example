# ============================================================
# AI Chart Vision Backend - Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Mock Mode (set "false" to use real APIs)
USE_MOCK_DATA=true

# AI Vision Service (optional - mock mode doesn't need these)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vision Capture (Playwright)
# CHART_CANVAS_SELECTOR=canvas

# Risk Management
CONFIDENCE_TIER_HIGH_MAX_PCT=3
CONFIDENCE_TIER_MED_MAX_PCT=1.5

# Alert Dispatch (Telegram - optional)
ALERT_COOLDOWN_MINUTES=15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
