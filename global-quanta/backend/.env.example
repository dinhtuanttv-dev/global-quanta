PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
USE_MOCK_DATA=true

# SSI FastConnect V2 (server only; never add these to VITE_* variables)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_DATA_API_BASE=https://fc-data.ssi.com.vn/api/v2
SSI_DATA_STREAM_URL=wss://fc-datahub.ssi.com.vn/v2.0

# ===== Market Data Gateway (SSI là nguồn chính, nguồn cũ là dự phòng) =====
# SSI API mới qua SDK chính thức @ssi.developer/ssi-sdk (để trống = tắt kênh v3).
SSI_V3_API_KEY=
SSI_V3_API_SECRET=
# SSI_V3_API_URL=https://api.ssi.com.vn
# SSI_V3_RATE_LIMIT_PER_SECOND=10
# SSI_V2_MAX_RANGE_DAYS=30

# Nguồn dự phòng (Project A + Yahoo phía server). LEGACY_MARKET_ENABLED=false để tắt.
LEGACY_MARKET_API_BASE=https://tuan-quant-scanner-psi.vercel.app
LEGACY_MARKET_ENABLED=true

# Kho dữ liệu: memory (mặc định) | supabase (cần SUPABASE_URL + SUPABASE_SECRET_KEY,
# chạy migration supabase/migrations/20261001000000_market_data.sql trước).
MARKET_STORE=memory
# Bật đồng bộ theo lịch (danh mục 08:15, trần/sàn 08:45, EOD 15:20, đối soát 15:50, backfill 02:00).
MARKET_INGESTOR_ENABLED=false
MARKET_RUN_JOBS_ON_START=true
MARKET_BACKFILL_YEARS=3
MARKET_BACKFILL_MAX_SYMBOLS=50
MARKET_EOD_UNIVERSE_INDICES=VN30,VN100
# MARKET_EOD_EXTRA_SYMBOLS=
# Ngày nghỉ lễ (YYYY-MM-DD, phân tách dấu phẩy) để không báo STALE oan.
# MARKET_HOLIDAYS=
# Token cho POST /api/market/admin/jobs/:name
MARKET_ADMIN_TOKEN=

# Stream: ngưỡng coi là dữ liệu cũ, chu kỳ poll dự phòng, kích thước shard (tối đa 50).
MARKET_STALE_MS=60000
MARKET_FALLBACK_POLL_MS=15000
MARKET_STREAM_SHARD_SIZE=50
MARKET_STREAM_MAX_SYMBOLS=500
MARKET_STREAM_INDICES=VNINDEX,VN30,HNXINDEX,HNXUPCOMINDEX
# MARKET_STREAM_UPSTREAM=none   # tắt stream SSI, chỉ dùng poll dự phòng

# Circuit breaker (hysteresis khi quay lại SSI).
MARKET_BREAKER_FAILURES=3
MARKET_BREAKER_WINDOW_MS=60000
MARKET_BREAKER_COOLDOWN_MS=30000
MARKET_BREAKER_RECOVERY_SUCCESSES=3
# Đổi thứ tự nguồn theo dataset nếu cần, VD: MARKET_CHAIN_OHLCV_DAILY=ssiFcV2,ssiV3,legacy
MARKET_ALERTS_ENABLED=true

# Nguồn nến cho scanner/backtest: market_service (SSI, khuyến nghị) | market_gateway | internal_api
# HISTORICAL_DATA_SOURCE=market_service
# MARKET_GATEWAY_URL=   # dùng cho bản Vercel serverless (api/scan.js)
